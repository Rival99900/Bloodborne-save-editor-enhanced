# Generated by Cargo
# will have compiled files and executables
src-tauri/debug/
src-tauri/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
src-tauri/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Ignore backup files
*.bak
src-tauri/*/*.tags 

node_modules/
build/
dist/

# .env
.env

.tauri/
src-tauri/vendor
flatpak
repo
*.flatpak

# Internal documentation stays local and is not published with the public source repository
UPDATER_IMPLEMENTATION_NOTES.md
docs/

# Local review packages and diagnostics must never be committed or published
.incoming-user-fix*/
.local-analysis/
