# Generated by Cargo
# will have compiled files and executables
src-tauri/debug/
src-tauri/target/

# Commit Cargo.lock for reproducible desktop builds.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Ignore backup files
*.bak
src-tauri/*/*.tags 

node_modules/
build/
dist/
docs/

# .env
.env

.tauri/
src-tauri/vendor
flatpak
repo
*.flatpak

# Private implementation notes
UPDATER_IMPLEMENTATION_NOTES.md

# Local review packages and diagnostics must never be committed or published
.incoming-user-fix*/
.local-analysis/

# Also ignore a symlinked dependency directory.
/node_modules

# Local diagnostic scripts; required CI tools live in .github/scripts
/scripts/
.github/scripts/**/__pycache__/

# Local backups, conversation notes, captures and generated release files
/exports/
/captures/
/verification/
/REPRISE_PROJET*.md
/HISTORIQUE_REPRISE*.md
/PATCHES_*_LOCAL.md
/CHANGEMENTS*.patch
/SHA256SUMS-SOURCE.txt
/Bloodborne-save-editor-enhanced*_LOCAL_*.zip
/release-assets/
/release-signatures/
/release-metadata.json
/latest.json
/SHA256SUMS.txt
*.log
__pycache__/
.vscode/
.idea/

# Local archives
*.zip
